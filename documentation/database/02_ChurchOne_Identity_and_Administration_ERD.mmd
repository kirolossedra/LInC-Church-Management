    }

    PEOPLE_NOTES_PERSON_IDENTITY {
        string person_id PK
        string full_name
        string contact
    }

    NEXTGEN_USER_IDENTITY {
        string user_id PK
        string normalized_user_id
        string full_name
        string email
    }

