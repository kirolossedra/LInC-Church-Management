erDiagram

    FIREBASE_AUTH_USER {
        string uid PK
        string email
    }

    ADMIN_USER {
        string uid PK
        string role
        string status
    }

    ASSESSMENT_FORM {
        string form_id PK
        string state
    }

    ASSESSMENT_RESPONSE {
        string response_id PK
        string form_id FK
        string user_identifier
        string full_name
        string email
    }

    PD_MEMBER {
        string member_key PK
        string identifier
        string group_code FK
    }

    PD_GROUP {
        string group_code PK
        string group_label
    }

    PD_NOTE {
        string note_id PK
        string member_key FK
        string note_type
    }

    PD_ASSIGNMENT {
        string assignment_id PK
        string assignment_text
        date assignment_date
    }

    PD_ASSIGNMENT_GROUP {
        string assignment_group_id PK
        string assignment_id FK
        string group_code FK
    }

    MEETING_REQUEST {
        string request_id PK
        string status
        string created_meeting_id FK
    }

    MEETING {
        string meeting_id PK
        string source_request_id FK
        date meeting_date
    }

    MEETING_PARTICIPANT {
        string participant_link_id PK
        string meeting_id FK
        string response_id FK
    }

    ATTENDANCE_PERSON {
        string attendance_person_id PK
        string full_name
        string email
    }

    NEXTGEN_USER {
        string user_id PK
        string full_name
        string status
    }

    NEXTGEN_QUESTION {
        string question_id PK
        string submitted_by_user_id FK
        string question_text
    }

    NEXTGEN_VOTE {
        string vote_id PK
        string question_id FK
        string user_id FK
        string vote_type
    }

    NEXTGEN_SURVEY_RESPONSE {
        string response_id PK
        string survey_id FK
        string user_id FK
    }

    TUTORIAL {
        string tutorial_id PK
        string title
        boolean published
    }

    TUTORIAL_PROGRESS {
        string progress_id PK
        string uid FK
        string tutorial_id FK
        boolean completed
    }

    FIREBASE_AUTH_USER ||--o| ADMIN_USER : has
    FIREBASE_AUTH_USER ||--o{ TUTORIAL_PROGRESS : records
    ASSESSMENT_FORM ||--o{ ASSESSMENT_RESPONSE : receives
    PD_GROUP ||--o{ PD_MEMBER : contains
    PD_MEMBER ||--o{ ASSESSMENT_RESPONSE : links
    PD_MEMBER ||--o{ PD_NOTE : has
    PD_ASSIGNMENT ||--o{ PD_ASSIGNMENT_GROUP : targets
    PD_GROUP ||--o{ PD_ASSIGNMENT_GROUP : receives
    MEETING_REQUEST |o--o| MEETING : creates
    MEETING ||--o{ MEETING_PARTICIPANT : includes
    ASSESSMENT_RESPONSE ||--o{ MEETING_PARTICIPANT : identifies
    NEXTGEN_USER ||--o{ NEXTGEN_QUESTION : submits
    NEXTGEN_USER ||--o{ NEXTGEN_VOTE : casts
    NEXTGEN_QUESTION ||--o{ NEXTGEN_VOTE : receives
    NEXTGEN_USER ||--o{ NEXTGEN_SURVEY_RESPONSE : submits
    TUTORIAL ||--o{ TUTORIAL_PROGRESS : tracks
