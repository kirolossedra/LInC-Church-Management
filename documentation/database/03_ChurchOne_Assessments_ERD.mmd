erDiagram

    ASSESSMENT_FORM_CONTROL {
        string form_id PK
        string state
        timestamp updated_at
        string updated_by
    }

    ASSESSMENT_RESPONSE {
        string response_id PK
        string form_id FK
        string response_kind
        string user_identifier
        string full_name
        string email
        string language
        json fields
        json scores
        json results
        timestamp created_at
    }

    RESPONSE_LINKAGE {
        string linkage_id PK
        string response_id FK
        string user_identifier
        string database_form_id
        string linked_form_id
    }

    RESPONSE_EMAIL_EVENT {
        string email_event_id PK
        string response_id FK
        string language
        string provider
        string message_id
        timestamp sent_at
    }

    PD_MEMBER {
        string member_key PK
        string identifier
        string full_name
        string email
        string group_code FK
    }

    PD_MEMBER_RESPONSE {
        string member_response_id PK
        string member_key FK
        string response_id FK
    }

    MEETING {
        string meeting_id PK
        date meeting_date
    }

    MEETING_PARTICIPANT {
        string participant_link_id PK
        string meeting_id FK
        string response_id FK
    }

    ASSESSMENT_FORM_CONTROL ||--o{ ASSESSMENT_RESPONSE : controls
    ASSESSMENT_RESPONSE ||--o| RESPONSE_LINKAGE : may_have
    ASSESSMENT_RESPONSE ||--o{ RESPONSE_EMAIL_EVENT : records
    PD_MEMBER ||--o{ PD_MEMBER_RESPONSE : owns
    ASSESSMENT_RESPONSE ||--o| PD_MEMBER_RESPONSE : links
    MEETING ||--o{ MEETING_PARTICIPANT : includes
    ASSESSMENT_RESPONSE ||--o{ MEETING_PARTICIPANT : identifies
