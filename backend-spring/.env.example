PORT=8080
APP_VERSION=0.0.2
CORS_ALLOWED_ORIGINS=https://lincministry.com,http://localhost:5173

# Keep false until the Firebase variables below are configured.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json
FIREBASE_CHECK_REVOKED_TOKENS=false
FIREBASE_ROLE_LOOKUP_TIMEOUT=5s
