PORT=8080
APP_VERSION=0.0.3
CORS_ALLOWED_ORIGINS=https://lincministry.com,http://localhost:5173

# Brevo values are required only when calling POST /api/v1/email/test.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified_sender@example.com
BREVO_SENDER_NAME=LinC Ministry
BREVO_TEST_RECIPIENT=fixed_test_recipient@example.com
BREVO_REQUEST_TIMEOUT=15s

# Keep false until the Firebase variables below are configured.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json
FIREBASE_CHECK_REVOKED_TOKENS=false
FIREBASE_ROLE_LOOKUP_TIMEOUT=5s
